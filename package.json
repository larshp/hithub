{
  "name": "hithub",
  "private": true,
  "version": "1.0.0",
  "description": "HitHub",
  "scripts": {
    "lint": "abaplint",
    "serialize": "node scripts/abapgit-metadata.mjs",
    "serialize:check": "node scripts/abapgit-metadata.mjs --check",
    "transpile": "abap_transpile abap_transpile.json",
    "unit": "npm run transpile && node scripts/run-unit.mjs",
    "unit:repeat": "npm run transpile && node scripts/run-unit-all.mjs --repeat 2",
    "smoke": "npm run transpile && node scripts/http-smoke.mjs",
    "contract": "npm run transpile && node scripts/rest-contract.mjs",
    "security": "npm run transpile && node scripts/security-smoke.mjs",
    "logging": "npm run transpile && node scripts/logging-smoke.mjs",
    "metrics": "npm run transpile && node scripts/metrics-smoke.mjs",
    "readiness": "npm run transpile && node scripts/readiness-smoke.mjs",
    "timeout": "npm run transpile && node scripts/timeout-smoke.mjs",
    "backpressure": "node scripts/backpressure-smoke.mjs",
    "load-soak": "npm run transpile && node scripts/load-soak.mjs",
    "restore-verify": "node scripts/restore-verify.mjs",
    "limits": "npm run transpile && node scripts/limits-smoke.mjs",
    "ui": "npm run transpile && node scripts/ui-smoke.mjs",
    "anomalies": "node scripts/verify-anomalies.mjs",
    "schema": "npm run transpile && node scripts/verify-schema.mjs",
    "web:preview": "npm run transpile && node scripts/build-preview.mjs",
    "web:screenshots": "node scripts/capture-web-screenshots.mjs",
    "web:diff": "node scripts/generate-screenshot-diffs.mjs deployment/main/screenshots build/screenshots build/visual-diffs",
    "web:build": "npm run web:preview && npm run web:screenshots && npm run web:diff",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "e2e:install": "playwright install chromium firefox",
    "native-ui-merge": "npm run transpile && node scripts/native-ui-merge.mjs",
    "native-rest-merge": "npm run transpile && node scripts/native-rest-merge.mjs",
    "native-fsck": "npm run transpile && node scripts/native-fsck.mjs",
    "native-race": "npm run transpile && node scripts/native-race.mjs",
    "fixtures": "node --test integration/fixtures/*.test.mjs",
    "start": "node server/index.mjs",
    "verify": "npm run lint && npm run serialize:check && npm run unit && npm run fixtures && npm run anomalies && npm run smoke",
    "test": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/larshp/hithub.git"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.48",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/runtime": "^2.13.85",
    "@abaplint/transpiler-cli": "^2.13.85",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "express": "^4.22.2",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "sql.js": "^1.14.2",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "terser-webpack-plugin": "^5.6.1",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.110.3"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/larshp/hithub/issues"
  },
  "homepage": "https://github.com/larshp/hithub#readme"
}
