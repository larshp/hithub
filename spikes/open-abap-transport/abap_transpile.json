{
  "input_folder": ["spikes/open-abap-transport"],
  "input_filter": [],
  "output_folder": "build/spikes/open-abap-transport",
  "libs": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abapGit/abapGit",
      "files": [
        "/src/git/**/*.*",
        "/src/http/zcl_abapgit_http.clas.abap",
        "/src/http/zcl_abapgit_http_client.clas.abap",
        "/src/http/zcl_abapgit_http_digest.clas.abap",
        "/src/convert/**/*.*",
        "/src/exception/**/*.*",
        "/src/zcl_abapgit_convert*.*",
        "/src/zcl_abapgit_injector*.*",
        "/src/zcl_abapgit_zlib*.*",
        "/src/utils/zcl_abapgit_convert*.*",
        "/src/utils/zcl_abapgit_string_map*.*",
        "/src/http/zcl_abapgit_url*.*",
        "/src/exits/zcl_abapgit_exit*.*",
        "/src/exits/zif_abapgit_exit*.*",
        "/src/ui/progress/zcl_abapgit_progress*.*",
        "/src/ui/progress/zif_abapgit_progress*.*",
        "/src/zif_abapgit*.*",
        "/src/zcx_abapgit*.*"
      ]
    }
  ],
  "write_unit_tests": false,
  "write_source_map": true,
  "options": {
    "ignoreSyntaxCheck": false,
    "addFilenames": true,
    "addCommonJS": true,
    "unknownTypes": "runtimeError"
  }
}
